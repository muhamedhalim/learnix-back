{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "maxWorkers": 1,
  "workerIdleMemoryLimit": "1536MB",
  "testRegex": ".e2e-spec.ts$",
  "setupFilesAfterEnv": [
    "<rootDir>/setup-e2e.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/global-setup-e2e.ts",
  "testTimeout": 30000
}
