# Copy to the backend root as .env.test before running npm run test:e2e.
# Start the disposable dependencies with npm run test:e2e:infra:up.
NODE_ENV=test
DATABASE_URL=postgres://postgres:lms_e2e_password@localhost:54329/lms_e2e
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false
JWT_SECRET=e2e-test-jwt-secret-not-for-production
COOKIE_SECRET=e2e-test-cookie-secret-not-for-production
INIT_SECRET=e2e-test-init-secret-0123456789abcdef-long
REDIS_URL=redis://localhost:56379/15
E2E_DISABLE_BACKGROUND_WORKERS=true
