{
  "name": "educational-platform-backend",
  "version": "0.0.1",
  "description": "Multi-role educational platform with video lessons, exams, and payment integration",
  "author": "Omar",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && nest build --builder swc",
    "format": "prettier --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:migrate:prod": "npm run migration:run:prod && npm run start:prod",
    "lint": "eslint . --fix --cache && prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:infra:up": "docker compose -f test/docker-compose.e2e.yml up -d --wait",
    "test:e2e:infra:down": "docker compose -f test/docker-compose.e2e.yml down --volumes --remove-orphans",
    "seed:admin": "ts-node src/database/seed-admin.ts",
    "seed:staging": "ts-node -r tsconfig-paths/register src/database/seed-staging.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- -d src/data-source.ts migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- -d src/data-source.ts migration:run",
    "migration:run:prod": "node dist/src/database/migrate-cli.js run",
    "migration:revert": "npm run typeorm -- -d src/data-source.ts migration:revert",
    "migration:show": "npm run typeorm -- -d src/data-source.ts migration:show",
    "migration:check": "npm run typeorm -- -d src/data-source.ts schema:log",
    "migrate:status": "ts-node -r tsconfig-paths/register src/database/migrate-cli.ts status",
    "migrate:run": "ts-node -r tsconfig-paths/register src/database/migrate-cli.ts run",
    "migrate:revert": "ts-node -r tsconfig-paths/register src/database/migrate-cli.ts revert",
    "test:migrations": "ts-node -r tsconfig-paths/register scripts/migration-chain-test.ts",
    "verify:migration-lock": "ts-node -r tsconfig-paths/register scripts/verify-migration-lock.ts",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "verify:seed-interconnection": "ts-node -r tsconfig-paths/register scripts/verify-seed-interconnection.ts",
    "verify:seed-idempotency": "ts-node -r tsconfig-paths/register scripts/verify-seed-idempotency.ts",
    "verify:seed-correlation": "ts-node -r tsconfig-paths/register scripts/seed-correlation-check.ts",
    "verify:prelaunch-reset": "ts-node -r tsconfig-paths/register scripts/verify-prelaunch-reset.ts",
    "fingerprint:secrets": "ts-node -r tsconfig-paths/register scripts/fingerprint-secrets.ts",
    "finance:preflight": "ts-node src/payments/financial-preflight.command.ts",
    "db:reset:prelaunch": "ts-node -r tsconfig-paths/register src/database/prelaunch-reset.cli.ts",
    "db:reset:prelaunch:prod": "node dist/src/database/prelaunch-reset.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@bull-board/api": "^6.14.2",
    "@bull-board/express": "^6.14.2",
    "@bull-board/nestjs": "^6.14.2",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/node": "^8.55.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/helmet": "^0.0.48",
    "@types/sanitize-html": "^2.16.0",
    "arabic-persian-reshaper": "^1.0.1",
    "axios": "^1.13.1",
    "bcryptjs": "^3.0.2",
    "bidi-js": "^1.0.3",
    "bullmq": "^5.64.1",
    "cache-manager": "^7.2.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dockerode": "^4.0.9",
    "exceljs": "^4.4.0",
    "express-basic-auth": "^1.2.1",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "mailersend": "^3.1.0",
    "multer": "^2.0.2",
    "noto-sans-arabic": "^1.0.2",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.11.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@darraghor/eslint-plugin-nestjs-typed": "^7.1.18",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/dockerode": "^3.3.44",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/papaparse": "^5.5.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-regexp": "^3.0.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^4.0.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "overrides": {
    "lodash": "^4.17.23",
    "fast-xml-parser": "^5.10.1",
    "body-parser": "^2.3.0",
    "readdir-glob": {
      "brace-expansion": "2.1.2"
    },
    "@angular-devkit/core": {
      "ajv": "8.18.0"
    },
    "@tootallnate/once": "3.0.1",
    "websocket-driver": "0.7.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
