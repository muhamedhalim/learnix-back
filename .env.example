# ==============================================================================
# EDUCATIONAL PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control - it contains sensitive information.

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/edu_platform

# TypeORM synchronize setting (CRITICAL: MUST be false in production!)
# WARNING: Setting this to true in production will cause data loss!
# Only use true in local development for automatic schema synchronization
TYPEORM_SYNCHRONIZE=false
# Set false for production-like local load tests without SQL console I/O.
TYPEORM_LOGGING=false
# Comma-separated Nest log levels. Example for load tests: error,warn
LOG_LEVELS=error,warn,log

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# JWT Secret Key - MUST be at least 32 characters long
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-secret-min-32-chars-change-this-in-production

# JWT Access Token expiration time (short-lived for security)
# Recommended: 15m for access tokens
JWT_EXPIRATION=15m

# JWT Refresh Token Secret - MUST be different from JWT_SECRET
JWT_REFRESH_SECRET=your-secure-random-refresh-secret-min-32-chars

# JWT Refresh Token expiration time (long-lived)
# Recommended: 7d for refresh tokens
JWT_REFRESH_EXPIRATION=7d

# Cookie signing secret for HttpOnly refresh-token cookies.
# MUST be at least 32 characters and different from JWT_SECRET.
COOKIE_SECRET=your-secure-random-cookie-secret-min-32-chars

# One-time first-admin endpoint secret. Leave unset/disabled after bootstrap.
INIT_SECRET=your-secure-random-init-secret-min-32-chars

# First-admin seed password. Use a generated one-time password, then rotate it.
ADMIN_INIT_EMAIL=admin@example.com
ADMIN_INIT_PASSWORD=replace-with-generated-strong-password-min-16-chars

# Bcrypt salt rounds (higher = more secure but slower)
# Recommended: 12 for production, 10 for development
BCRYPT_ROUNDS=12

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Node environment (development, production, test)
NODE_ENV=development

# Port number for the application
PORT=3000

# ==============================================================================
# REDIS & CACHING
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional full connection URL (overrides REDIS_HOST/PORT/PASSWORD when set).
# Redis is REQUIRED in production — the app refuses to start with an in-memory
# cache when NODE_ENV=production. It also backs the rate limiter so limits are
# shared across instances.
REDIS_URL=

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# ==============================================================================
# BULL BOARD (queue dashboard at /admin/queues) — HTTP Basic Auth
# Required to access the dashboard; when unset it is inaccessible (fails closed).
# ==============================================================================
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me-to-a-long-random-value

# ==============================================================================
# DATABASE CONNECTION POOL (optional; sensible defaults applied)
# ==============================================================================
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# ==============================================================================
# BUNNY.NET STREAM VIDEO HOSTING
# ==============================================================================
# Get these from: Bunny Dashboard > Stream > Your Video Library > API tab
# Documentation: https://docs.bunny.net/docs/stream-overview

# Videos are uploaded DIRECTLY to Bunny Stream from the browser using a
# resumable TUS upload. The backend creates the video object and signs each
# upload; the Stream API key NEVER reaches the frontend. When these are unset,
# the video-upload endpoints return 503 (uploads disabled) and the rest of the
# app keeps working.

# Stream Library ID (required for video upload + playback)
# Found in your video library's API settings
BUNNY_STREAM_LIBRARY_ID=your_library_id_here

# Stream API Key (REQUIRED for upload — server-side only, never exposed).
# Videos are proxied through THIS backend to Bunny; the browser never gets it.
# Found in your video library's API settings (each library has its own key).
# The backend also accepts BUNNY_API_KEY (below) as a fallback for this value.
BUNNY_STREAM_API_KEY=your_stream_api_key_here

# Stream pull-zone hostname for HLS playback + auto-generated posters,
# e.g. "vz-xxxxxxxx-xxx.b-cdn.net" (Stream library > API > "CDN Hostname").
# Optional: when unset, the iframe embed URL is used for playback.
BUNNY_STREAM_CDN_HOSTNAME=
# Alias accepted by the backend if you prefer this name:
# BUNNY_STREAM_PULL_ZONE=

# Stream "Token Authentication Key" (Stream library > API), used to sign
# short-lived playback URLs so only authorized/enrolled users can watch.
# Enable "Embed View Token Authentication" on the library. When unset, the
# GET /lessons/:id/signed-url endpoint returns 503 and playback is disabled.
BUNNY_STREAM_TOKEN_KEY=

# ------------------------------------------------------------------------------
# Bunny.net STORAGE + CDN (for course/lesson thumbnails & lesson attachments)
# ------------------------------------------------------------------------------
# Videos use Bunny STREAM above (token-protected, non-downloadable HLS).
# Images/PDFs/attachments use Bunny STORAGE served via the CDN pull zone.
# Leave blank to fall back to local/URL handling until storage is configured.
# Storage Zone name (Bunny Dashboard > Storage)
BUNNY_STORAGE_ZONE=
# Storage Zone password / access key
BUNNY_STORAGE_PASSWORD=
# Storage region code, e.g. "de", "ny", "sg" (blank = default/Falkenstein)
BUNNY_STORAGE_REGION=
# Public CDN base URL for the pull zone, e.g. https://your-zone.b-cdn.net
BUNNY_CDN_URL=
# Pull Zone name (used for signed/token URLs)
BUNNY_PULL_ZONE=
# Account-level API key (for managing zones, optional)
BUNNY_API_KEY=

# ==============================================================================
# EASYKASH PAYMENT INTEGRATION
# ==============================================================================
# EasyKash API credentials for payment processing.
# Get these from your EasyKash merchant dashboard.
EASYKASH_API_KEY=your-easykash-api-key
EASYKASH_HMAC_SECRET=your-easykash-hmac-secret
EASYKASH_API_URL=https://back.easykash.net

# ==============================================================================
# FIREBASE (SMS NOTIFICATIONS TO PARENTS)
# ==============================================================================
# Firebase Admin SDK credentials
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# ==============================================================================
# CORS & FRONTEND
# ==============================================================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Allowed CORS origins (comma-separated, EXACT match — no wildcards).
# In production set this to your real frontend origin(s), e.g.:
#   CORS_ORIGINS=https://learnix.school
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# EMAIL / SMTP (password reset & transactional email)
# ==============================================================================
# Leave SMTP_HOST empty in local dev: emails are logged instead of sent, and the
# password-reset token is returned in the API response (non-production only) so
# the flow stays testable without a mail server.
SMTP_HOST=
SMTP_PORT=587
# Set to "true" for implicit TLS (port 465); otherwise STARTTLS is used.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# From header used on outgoing mail.
MAIL_FROM=no-reply@learning-center.local
MAIL_FROM_NAME=Learning Center
# Password reset token lifetime (duration string: 1h, 30m, 2d, ...). Default 1h.
PASSWORD_RESET_EXPIRATION=1h

# ==============================================================================
# FILE UPLOADS
# ==============================================================================
# Directory for uploaded files (books, exam images, etc.)
UPLOAD_DIR=./uploads

# Local private storage root. Must not be inside a public static web root.
PRIVATE_UPLOAD_DIR=./private-uploads

# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Allowed file types for uploads
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# ==============================================================================
# RATE LIMITING
# ==============================================================================
# Throttle TTL in seconds
THROTTLE_TTL=60

# Maximum requests per TTL period
THROTTLE_LIMIT=100

# ==============================================================================
# LESSON ACCESS SETTINGS
# ==============================================================================
# Default lesson access duration in days
DEFAULT_LESSON_ACCESS_DAYS=7

# Maximum extension days per request (admin-controlled)
MAX_EXTENSION_DAYS=1
# Performance observability
# Aggregate query timing is always collected. Enable this only when every query
# must also produce a JSON log line; high-volume logging has measurable cost.
PERFORMANCE_QUERY_LOGGING=false
PERFORMANCE_SLOW_QUERY_MS=100
PERFORMANCE_HTTP_LOGGING=true
# Required for GET /metrics. Use a high-entropy secret in the scraper's
# Authorization: Bearer <token> header. The endpoint fails closed if omitted.
METRICS_BEARER_TOKEN=replace-with-a-long-random-token

# Cross-replica cache stampede protection
CACHE_LOCK_TTL_MS=10000
CACHE_LOCK_WAIT_TIMEOUT_MS=3000
CACHE_LOCK_POLL_INTERVAL_MS=20
