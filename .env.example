# ==============================================================================
# EDUCATIONAL PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control - it contains sensitive information.

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/edu_platform

# TypeORM synchronize setting (CRITICAL: MUST be false in production!)
# WARNING: Setting this to true in production will cause data loss!
# Only use true in local development for automatic schema synchronization
TYPEORM_SYNCHRONIZE=false

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# JWT Secret Key - MUST be at least 32 characters long
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-secret-min-32-chars-change-this-in-production

# JWT Access Token expiration time (short-lived for security)
# Recommended: 15m for access tokens
JWT_EXPIRATION=15m

# JWT Refresh Token Secret - MUST be different from JWT_SECRET
JWT_REFRESH_SECRET=your-secure-random-refresh-secret-min-32-chars

# JWT Refresh Token expiration time (long-lived)
# Recommended: 7d for refresh tokens
JWT_REFRESH_EXPIRATION=7d

# Bcrypt salt rounds (higher = more secure but slower)
# Recommended: 12 for production, 10 for development
BCRYPT_ROUNDS=12

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Node environment (development, production, test)
NODE_ENV=development

# Port number for the application
PORT=3000

# ==============================================================================
# REDIS & CACHING
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# ==============================================================================
# BUNNY.NET STREAM VIDEO HOSTING
# ==============================================================================
# Get these from: Bunny Dashboard > Stream > Your Video Library > API tab
# Documentation: https://docs.bunny.net/docs/stream-overview

# Stream Library ID (required for video playback)
# Found in your video library's API settings
BUNNY_STREAM_LIBRARY_ID=your_library_id_here

# Stream API Key (optional, only for analytics features)
# Found in your video library's API settings
# Note: This is NOT your account API key - each library has its own API key
BUNNY_STREAM_API_KEY=your_stream_api_key_here

# ==============================================================================
# PAYMOB PAYMENT INTEGRATION
# ==============================================================================
# Paymob API credentials for payment processing
# Get these from: https://accept.paymob.com/portal2/en/settings
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=your-paymob-integration-id
PAYMOB_IFRAME_ID=your-paymob-iframe-id
PAYMOB_HMAC_SECRET=your-paymob-hmac-secret
PAYMOB_CALLBACK_URL=http://localhost:3000/api/payments/paymob/callback

# ==============================================================================
# FIREBASE (SMS NOTIFICATIONS TO PARENTS)
# ==============================================================================
# Firebase Admin SDK credentials
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# ==============================================================================
# CORS & FRONTEND
# ==============================================================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# FILE UPLOADS
# ==============================================================================
# Directory for uploaded files (books, exam images, etc.)
UPLOAD_DIR=./uploads

# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Allowed file types for uploads
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# ==============================================================================
# RATE LIMITING
# ==============================================================================
# Throttle TTL in seconds
THROTTLE_TTL=60

# Maximum requests per TTL period
THROTTLE_LIMIT=100

# ==============================================================================
# LESSON ACCESS SETTINGS
# ==============================================================================
# Default lesson access duration in days
DEFAULT_LESSON_ACCESS_DAYS=7

# Maximum extension days per request (admin-controlled)
MAX_EXTENSION_DAYS=1
