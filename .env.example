# ==============================================================================
# EDUCATIONAL PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control - it contains sensitive information.

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/edu_platform

# TypeORM synchronize setting (CRITICAL: MUST be false in production!)
# WARNING: Setting this to true in production will cause data loss!
# Only use true in local development for automatic schema synchronization
# Refused outright on staging/production by two independent checks:
# app.module.ts throws when NODE_ENV=production, and the environment-isolation
# guard (STAGING_SYNCHRONIZE_ENABLED) additionally checks APP_ENV=staging, so
# a misconfigured staging deployment can't slip through by running the wrong
# NODE_ENV. Schema is managed exclusively by migrations outside of NODE_ENV=test.
TYPEORM_SYNCHRONIZE=false
# Set false for production-like local load tests without SQL console I/O.
TYPEORM_LOGGING=false
# Comma-separated Nest log levels. Example for load tests: error,warn
LOG_LEVELS=error,warn,log

# SSL is derived from DATABASE_URL's hostname (off for localhost/127.0.0.1,
# on otherwise) — see common/utils/database-ssl.util.ts's own header comment
# for why this is deliberately NOT an env-driven on/off switch (it broke in
# both directions when it used to be). No DATABASE_SSL variable exists on
# purpose; SSL_REJECT_UNAUTHORIZED (below) is the one supported override.
# SSL_REJECT_UNAUTHORIZED=true

# Connection pool tuning. These ARE this project's DATABASE_POOL_MAX /
# DATABASE_CONNECTION_TIMEOUT_MS / DATABASE_IDLE_TIMEOUT_MS — kept under
# their original DB_POOL_* names rather than duplicated under new ones.
# Sized conservatively so staging cannot exhaust a shared/small Railway
# Postgres plan's connection limit.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Skips the external `migration:run:prod` step's advisory-locked migration
# run on boot. Default unset = migrations run automatically (today's
# behaviour, unchanged). Set to "false" only if your deploy topology runs
# migrations from a separate, explicit, out-of-band step instead — the
# advisory lock in database/migration-lock.util.ts already makes concurrent
# automatic runs across replicas safe, so this is an escape hatch, not a
# requirement.
# RUN_MIGRATIONS=false

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================
# JWT Secret Key - MUST be at least 32 characters long
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-secret-min-32-chars-change-this-in-production

# JWT Access Token expiration time (short-lived for security)
# Recommended: 15m for access tokens
JWT_EXPIRATION=15m

# JWT Refresh Token Secret - MUST be different from JWT_SECRET
JWT_REFRESH_SECRET=your-secure-random-refresh-secret-min-32-chars

# JWT Refresh Token expiration time (long-lived)
# Recommended: 7d for refresh tokens
JWT_REFRESH_EXPIRATION=7d

# Cookie signing secret for HttpOnly access and refresh-token cookies.
# MUST be at least 32 characters and different from JWT_SECRET.
COOKIE_SECRET=your-secure-random-cookie-secret-min-32-chars

# One-time first-admin endpoint secret. Leave unset/disabled after bootstrap.
INIT_SECRET=your-secure-random-init-secret-min-32-chars

# First-admin seed password. Use a generated one-time password, then rotate it.
ADMIN_INIT_EMAIL=admin@example.com
ADMIN_INIT_PASSWORD=replace-with-generated-strong-password-min-16-chars

# Bcrypt salt rounds (higher = more secure but slower)
# Recommended: 12 for production, 10 for development
BCRYPT_ROUNDS=12

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Node environment (development, production, test).
# NOTE: this is a BEHAVIOUR switch, not a label. It decides whether Redis and
# object storage are mandatory, whether CSP is applied, whether stack traces and
# password-reset tokens are withheld from responses, whether cookies are Secure,
# and whether Paymob defaults to live mode. STAGING MUST SET production HERE —
# it needs all of those protections. Use APP_ENV below to say what the
# deployment actually is. "staging" is NOT a valid NODE_ENV.
NODE_ENV=development

# Deployment identity: production | staging | test | development.
# Optional and derived from NODE_ENV when unset, so existing deployments are
# unaffected. Setting it explicitly is strongly recommended.
# Drives: Sentry/log/health labels, the cross-environment isolation guard
# (src/config/environment-isolation.guard.ts), and the login rate-limit
# resolution (src/common/throttle/login-throttle.ts).
APP_ENV=development

# When true, APP_ENV must be supplied explicitly instead of derived.
APP_ENV_STRICT=false

# Port number for the application
PORT=3001

# ==============================================================================
# CROSS-ENVIRONMENT ISOLATION GUARD
# ==============================================================================
# Enforced when APP_ENV=staging (and, in mirror form, when APP_ENV=production).
# The guard ships with protective defaults; these EXTEND them per deployment.
# It runs inside ConfigModule's validate(), before any module, queue, cron
# trigger or database connection exists. See docs/CRON_AUDIT.md for why that
# ordering matters.
#
# Exact hostnames belonging to production (comma-separated).
PROD_HOST_DENYLIST=
# Production resource identifiers with no hostname: bucket names, Bunny library
# IDs, database names.
PROD_IDENTIFIER_DENYLIST=
# Accepted as a combined alias for both lists above.
PROD_RESOURCE_DENYLIST=
# Production sender addresses staging must never send from.
PROD_SENDER_DENYLIST=
# SHA-256 fingerprints (first 16 hex chars) of production secrets. ONLY hashes
# are stored — never a secret value — so a production credential can be blocked
# from staging without being written down. Generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update(process.env.SECRET||'').digest('hex').slice(0,16))"
PROD_SECRET_FINGERPRINTS=

# Redis key namespace, applied to every cache, BullMQ queue, rate-limit and
# idempotency/lock key this application writes (common/utils/redis-namespace.util.ts).
# One variable covers all of them by design — separate QUEUE_PREFIX /
# CACHE_PREFIX / RATE_LIMIT_PREFIX variables were deliberately NOT added,
# since letting an operator set them independently would let one subsystem's
# prefix drift from another's, undermining the whole point (an environment's
# keys are either fully separated or they aren't).
#
# Leave UNSET on production: it then resolves to an empty prefix, which is
# byte-identical to this application's key shape before namespacing existed —
# zero behaviour change for the currently-deployed service.
#
# On staging and NODE_ENV=test, a sensible default applies even when this is
# left unset ("learnix:staging" / "learnix:test" respectively), since neither
# has any legacy key to stay compatible with. Set it explicitly only to
# override that default, e.g. for a second, differently-named staging
# instance. Must be staging-marked (contain "staging" or "stg") whenever
# APP_ENV=staging — enforced by the environment-isolation guard.
REDIS_NAMESPACE=

# Never set. Cookies are host-only, which is exactly what stops production and
# staging sharing credentials. Declared so the guard can reject a shared
# parent-domain value if it is ever introduced.
COOKIE_DOMAIN=

# ==============================================================================
# SCHEDULED-WORK FEATURE FLAGS
# ==============================================================================
# Every flag DEFAULTS TO ENABLED and is disabled only by the exact string
# "false". "FALSE", "0", "no" and "off" all leave the flag ENABLED — disabling a
# financial job must be unambiguous. Leave all of these UNSET in production.
# Full impact analysis: docs/CRON_AUDIT.md
#
# FINANCIAL: per-minute payment reconciliation + 30-minute settlement sweep.
ENABLE_PAYMENT_RECONCILIATION=
# FINANCIAL: per-minute gateway webhook replay.
ENABLE_WEBHOOK_REPLAY=
# DESTRUCTIVE: weekly orphan-file deletion + 30-minute expired-upload cleanup.
# Set to false on a new environment until its storage isolation is confirmed.
ENABLE_FILE_CLEANUP=
# CONTACTS REAL PEOPLE: outbound guardian notification delivery.
ENABLE_NOTIFICATIONS=
# Master switch for all BullMQ queue processing.
ENABLE_BACKGROUND_JOBS=

# ==============================================================================
# LOGIN RATE LIMIT
# ==============================================================================
# Login is pinned to THROTTLE.AUTH (5 attempts / 5 minutes) on production and
# these variables are IGNORED there. Only non-production deployments may raise
# the limit, for automated QA suites that log in repeatedly from one IP.
# Clamped to 200 requests and a minimum 1000ms window.
LOGIN_THROTTLE_LIMIT=
LOGIN_THROTTLE_TTL_MS=

# ==============================================================================
# REDIS & CACHING
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional full connection URL (overrides REDIS_HOST/PORT/PASSWORD when set).
# Redis is REQUIRED in production — the app refuses to start with an in-memory
# cache when NODE_ENV=production. It also backs the rate limiter so limits are
# shared across instances.
REDIS_URL=
PROCESS_ROLE=api
HEALTH_COLLECTOR_PROCESS_ROLE=api
HEALTH_COLLECTOR_CADENCE_SECONDS=60
HEALTH_COLLECTOR_LOCK_TTL_MS=120000

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# ==============================================================================
# BULL BOARD (queue dashboard at /admin/queues) — HTTP Basic Auth
# Required to access the dashboard; when unset it is inaccessible (fails closed).
# ==============================================================================
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me-to-a-long-random-value

# ==============================================================================
# DATABASE CONNECTION POOL (optional; sensible defaults applied)
# ==============================================================================
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# ==============================================================================
# BUNNY.NET STREAM VIDEO HOSTING
# ==============================================================================
# Get these from: Bunny Dashboard > Stream > Your Video Library > API tab
# Documentation: https://docs.bunny.net/docs/stream-overview

# Videos are uploaded DIRECTLY to Bunny Stream from the browser using a
# resumable TUS upload. The backend creates the video object and signs each
# upload; the Stream API key NEVER reaches the frontend. When these are unset,
# the video-upload endpoints return 503 (uploads disabled) and the rest of the
# app keeps working.

# Stream Library ID (required for video upload + playback)
# Found in your video library's API settings
BUNNY_STREAM_LIBRARY_ID=your_library_id_here

# Stream API Key (REQUIRED for upload — server-side only, never exposed).
# Videos are proxied through THIS backend to Bunny; the browser never gets it.
# Found in your video library's API settings (each library has its own key).
# The backend also accepts BUNNY_API_KEY (below) as a fallback for this value.
BUNNY_STREAM_API_KEY=your_stream_api_key_here

# Stream pull-zone hostname for HLS playback + auto-generated posters,
# e.g. "vz-xxxxxxxx-xxx.b-cdn.net" (Stream library > API > "CDN Hostname").
# Optional: when unset, the iframe embed URL is used for playback.
BUNNY_STREAM_CDN_HOSTNAME=
# Alias accepted by the backend if you prefer this name:
# BUNNY_STREAM_PULL_ZONE=

# Stream "Token Authentication Key" (Stream library > API), used to sign
# short-lived playback URLs so only authorized/enrolled users can watch.
# Enable "Embed View Token Authentication" on the library. When unset, the
# GET /lessons/:id/signed-url endpoint returns 503 and playback is disabled.
BUNNY_STREAM_TOKEN_KEY=

# ------------------------------------------------------------------------------
# Cloudflare R2 (preferred for public images and private documents)
# ------------------------------------------------------------------------------
# The bucket MUST have anonymous/public access disabled because it also stores
# paid books, lesson resources, homework submissions and administrative files.
# Public thumbnails are streamed through PUBLIC_MEDIA_BASE_URL by the backend.
# Checked by the isolation guard on staging (via PROD_IDENTIFIER_DENYLIST) so a
# correctly-named staging bucket under the SAME Cloudflare account is still
# flagged — a bucket name alone does not prove the account differs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
# Optional legacy public/custom origin used only to recognize and migrate old
# stored URLs. New API responses never expose this provider URL.
R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# Bunny.net STORAGE + CDN (development/public assets only)
# ------------------------------------------------------------------------------
# Videos use Bunny STREAM above (token-protected, non-downloadable HLS).
# Production startup rejects Bunny-only storage because its public pull zone
# cannot protect paid/private objects. Configure private R2 in production.
# Storage Zone name (Bunny Dashboard > Storage)
BUNNY_STORAGE_ZONE=
# Storage Zone password / access key
BUNNY_STORAGE_PASSWORD=
# Storage region code, e.g. "de", "ny", "sg" (blank = default/Falkenstein)
BUNNY_STORAGE_REGION=
# Public CDN base URL for the pull zone, e.g. https://your-zone.b-cdn.net
BUNNY_CDN_URL=
# Pull Zone name (used for signed/token URLs)
BUNNY_PULL_ZONE=
# Account-level API key (for managing zones, optional)
BUNNY_API_KEY=

# ==============================================================================
# PAYMOB PAYMENT INTEGRATION
# ==============================================================================
# Paymob credentials and card checkout identifiers.
# Get these from the Paymob merchant dashboard.
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
# On staging these MUST be the TEST merchant's own integration/iframe IDs, not
# production's. Whether Paymob treats a transaction as real money is decided
# by which integration reference is submitted — PAYMOB_EXPECTED_MODE is only
# this app's own belief and does not change that. Checked by the isolation
# guard via PROD_IDENTIFIER_DENYLIST.
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_WEBHOOK_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com

# Payment mode: test | live. REQUIRED to be "live" on production whenever
# PAYMOB_API_KEY is set, and REQUIRED to be "test" on staging (enforced by the
# isolation guard). This is the primary defence against a staging deployment
# producing real charges.
PAYMOB_EXPECTED_MODE=

# Required explicitly in production. Trusted provider capture time may arrive
# shortly after local expiry; maximum accepted future clock skew.
PAYMENT_CAPTURE_GRACE_SECONDS=300
PAYMENT_PROVIDER_CLOCK_SKEW_SECONDS=120

# Scheduled Individual lesson reservations. A checkout hold is never allowed
# to extend past the booking cutoff before the appointment starts.
LESSON_SESSION_HOLD_MINUTES=10
LESSON_SESSION_BOOKING_CUTOFF_MINUTES=60

# Payment-gateway fee in basis points, used by commission calculation.
DEFAULT_GATEWAY_FEE_BPS=0

# ==============================================================================
# UNIFIED COMMERCE, COMMISSIONS & SETTLEMENTS
# ==============================================================================
# Platform commission in basis points. 3000 = 30.00%.
DEFAULT_PLATFORM_COMMISSION_BPS=3000
# Delay before platform-collected teacher earnings become settlement-eligible.
TEACHER_EARNING_HOLD_DAYS=7
# Minimum teacher payout in minor units. 10000 = EGP 100.00.
MINIMUM_SETTLEMENT_MINOR=10000
# Optional ceiling for existing + projected platform receivables when issuing
# teacher/center/agent-collected activation-code batches. 0 disables the limit.
TEACHER_CODE_RECEIVABLE_LIMIT_MINOR=0

# ==============================================================================
# FIREBASE (ID-token verification for Firebase-authenticated sign-in)
# ==============================================================================
# Firebase Admin SDK credentials. NOTE: as of Phase 3's audit, the only actual
# use in this codebase is verifying ID tokens for sign-in (users.service.ts's
# syncFirebaseUser) — not SMS or push notifications, despite this section's
# historical heading. Use a separate Firebase project on staging: a shared
# project means a token minted by the production app would authenticate here
# too. Checked by the isolation guard via PROD_IDENTIFIER_DENYLIST.
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# ==============================================================================
# GUARDIAN VERIFICATION & DELIVERY CHANNELS
# ==============================================================================
# Configure at least one delivery provider in production so guardian OTPs can
# be delivered. Values are server-only; never expose them to the frontend.
# Twilio SMS (optional fallback channel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Meta WhatsApp Cloud API (preferred guardian channel when configured)
# Use a Meta TEST phone number on staging — Meta requires senders to be
# pre-registered, so reusing production's number would send from the real
# business number. Checked by the isolation guard via PROD_IDENTIFIER_DENYLIST.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
# Verifies the X-Hub-Signature-256 HMAC on Meta delivery webhooks.
META_WHATSAPP_APP_SECRET=
# Echoed back during Meta's one-time webhook subscription handshake.
META_WHATSAPP_VERIFY_TOKEN=

# Outbound messaging mode: sandbox | live. Read only for its presence by the
# boot guard (staging must have this set to "sandbox" whenever SMS/WhatsApp
# credentials exist); the actual runtime enforcement is keyed on APP_ENV
# directly (see SMS_ALLOWLIST below), so it applies even if this is left unset.
SMS_MODE=

# STAGING-ONLY recipient allowlist for SMS and WhatsApp, comma-separated E.164
# numbers (e.g. +201000000001,+201000000002). A number on this list still
# receives a REAL message on staging (so a UAT tester's own phone can verify
# delivery); every other number is sandboxed — logged and reported as
# delivered, with zero outbound call to Twilio or Meta. Empty/unset means
# every real number is sandboxed. No effect on production.
SMS_ALLOWLIST=

# ==============================================================================
# CORS & FRONTEND
# ==============================================================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000

# Public backend origin used to build browser-facing media-proxy URLs. In
# production both values MUST be the real HTTPS API origin, never localhost.
# Set NODE_ENV=production in the deployment as well; startup validation rejects
# localhost, private IPs, HTTP, paths, credentials, queries, and fragments.
# Example (replace with this deployment's real API domain):
# BACKEND_URL=https://api.example.com
# PUBLIC_MEDIA_BASE_URL=https://api.example.com
BACKEND_URL=http://localhost:3001
PUBLIC_MEDIA_BASE_URL=http://localhost:3001

# Allowed CORS origins (comma-separated, EXACT match — no wildcards).
# In production set this to your real frontend origin(s), e.g.:
#   CORS_ORIGINS=https://learnix.school
CORS_ORIGINS=http://localhost:3000

# ==============================================================================
# EMAIL / MAILERSEND (transactional email)
# ==============================================================================
# Set MAIL_PROVIDER to mailersend to enable delivery. Any other value leaves the
# provider uninitialized and prevents MailerSend API calls.
MAIL_PROVIDER=mailersend
MAILERSEND_API_KEY=
MAIL_FROM_EMAIL=no-reply@learning-center.local
MAIL_FROM_NAME=Learning Center
MAIL_REPLY_TO=
# MailerSend template IDs. When set, MailService uses setTemplateId() and
# personalization data; IDs are never hardcoded in application code.
MAILERSEND_TEMPLATE_WELCOME=
MAILERSEND_TEMPLATE_PASSWORD_RESET=
MAILERSEND_TEMPLATE_LOGIN_VERIFICATION=
MAILERSEND_TEMPLATE_INVITATION=
MAILERSEND_TEMPLATE_PAYMENT_CONFIRMATION=
MAILERSEND_TEMPLATE_INVOICE=
MAILERSEND_TEMPLATE_CERTIFICATE=
MAILERSEND_TEMPLATE_HOMEWORK=
MAILERSEND_TEMPLATE_EXAM=
MAILERSEND_TEMPLATE_SUBSCRIPTION=
# Password reset token lifetime (duration string: 1h, 30m, 2d, ...). Default 1h.
PASSWORD_RESET_EXPIRATION=1h

# STAGING-ONLY outbound mail allowlist: comma-separated addresses or bare
# domains. An address on this list (or under an allowlisted domain) still
# receives a REAL email on staging; every other address is blocked before
# MailerSend is ever called (mail.service.ts's deliver(), the only call site
# that reaches the provider) and logged without the raw address. Also applies
# a "[STAGING] " subject prefix to every non-templated send on staging.
# REQUIRED by the isolation guard on staging whenever MailerSend is
# configured — without it, every address in the database is mailable. FORBIDDEN
# on production, where it would silently discard customer mail.
MAIL_ALLOWLIST=

# ==============================================================================
# FILE UPLOADS
# ==============================================================================
# Directory for uploaded files (books, exam images, etc.)
UPLOAD_DIR=./uploads

# Local private storage root. Must not be inside a public static web root.
PRIVATE_UPLOAD_DIR=./private-uploads

# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760
# Upload ceiling read by the uploads module (bytes).
UPLOAD_MAX_BYTES=10485760

# Allowed file types for uploads
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png

# Lifetime of generated signed object URLs, in seconds (default 300).
SIGNED_URL_EXPIRES_SECONDS=300

# Attendance-code export artefacts.
CODE_EXPORT_DIR=./exports
CODE_EXPORT_TTL_HOURS=24
# Public base URL embedded in activation-code redemption links / QR codes.
# Environment-specific: must point at THIS deployment's frontend.
CODE_REDEEM_BASE_URL=

# Optional logo rendered onto generated certificate PDFs.
CERTIFICATE_LOGO_PATH=

# ==============================================================================
# QUEUE / WORKER TUNING
# ==============================================================================
# Retry attempts and exponential-backoff base for BullMQ jobs.
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
# Concurrent jobs per worker.
WORKER_CONCURRENCY=5
# Legacy aliases, still read as fallbacks. Prefer the names above.
# QUEUE_MAX_ATTEMPTS=
# QUEUE_BACKOFF_DELAY=
# QUEUE_CONCURRENCY=

# ==============================================================================
# API DOCUMENTATION
# ==============================================================================
# Swagger at /api is served automatically outside production. Set to "true" to
# re-enable it on a NODE_ENV=production deployment — this is how staging keeps
# its API docs while retaining every other production protection.
ENABLE_SWAGGER=

# ==============================================================================
# TLS / TEST HARNESS
# ==============================================================================
# Database SSL is derived from the connection host, not NODE_ENV (see
# common/utils/database-ssl.util.ts). Set to "false" ONLY for a managed
# provider presenting a self-signed certificate.
SSL_REJECT_UNAUTHORIZED=

# Honoured only when NODE_ENV=test: suppresses BullMQ workers so the E2E suite
# can truncate and reseed deterministically. Ignored everywhere else.
E2E_DISABLE_BACKGROUND_WORKERS=

# Overrides the shared password used by the synthetic staging seed
# (src/database/seed-staging.ts). Staging-only; not a production credential.
SEED_STAGING_PASSWORD=

# Second, independent arming step required before the synthetic seed (or its
# --reset path) will run at all — separate from and in addition to the
# target-identity checks (APP_ENV/host/database-name) the seed always runs.
# Must be exactly "true". A correctly-identified staging database can still
# be mid-UAT with tester progress on it; this stops the seed (especially
# --reset, which truncates tables) from ever running as a side effect of
# another command or a copy-pasted script. Staging-only; leave unset on
# production and development.
ALLOW_STAGING_SEED=

# Postgres server the migration-chain test creates and drops a temporary
# database on (npm run test:migrations). Derived from DATABASE_URL when unset.
MIGRATION_TEST_ADMIN_URL=

# ==============================================================================
# BUILD / DEPLOY METADATA (usually injected by the platform)
# ==============================================================================
# APP_VERSION, FRONTEND_VERSION, GIT_COMMIT, RAILWAY_GIT_COMMIT_SHA,
# RENDER_GIT_COMMIT, INSTANCE_ID, RAILWAY_REPLICA_ID, HOSTNAME, TZ
# are read for health/observability output. Leave unset locally.

# Health-check tuning (optional; sensible defaults applied).
HEALTH_CACHE_TTL_MS=
HEALTH_CHECK_TIMEOUT_MS=
HEALTH_PROVIDER_CHECK_INTERVAL_MS=300000

# ==============================================================================
# RATE LIMITING
# ==============================================================================
# Throttle TTL in seconds
THROTTLE_TTL=60

# Maximum requests per TTL period
THROTTLE_LIMIT=100

# ==============================================================================
# LESSON ACCESS SETTINGS
# ==============================================================================
# Default lesson access duration in days
DEFAULT_LESSON_ACCESS_DAYS=7

# Maximum extension days per request (admin-controlled)
MAX_EXTENSION_DAYS=1
# Performance observability
# Aggregate query timing is always collected. Enable this only when every query
# must also produce a JSON log line; high-volume logging has measurable cost.
PERFORMANCE_QUERY_LOGGING=false
PERFORMANCE_SLOW_QUERY_MS=100
PERFORMANCE_HTTP_LOGGING=true
# Required for GET /metrics. Use a high-entropy secret in the scraper's
# Authorization: Bearer <token> header. The endpoint fails closed if omitted.
METRICS_BEARER_TOKEN=replace-with-a-long-random-token

# Sentry error + performance monitoring (optional; disabled when DSN unset).
# Sentry v8 tracing is OpenTelemetry-based and auto-instruments HTTP/DB/Redis.
#
# SENTRY_ENABLED is a real kill-switch: the exact string "false" prevents the
# SDK initialising even when SENTRY_DSN is set. Any other value (or unset)
# leaves the DSN-only behaviour unchanged.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Release identifier attached to every Sentry event, structured log line and
# the /metrics `backend_build_info` gauge. Resolution order:
#   SENTRY_RELEASE -> APP_VERSION -> RAILWAY_GIT_COMMIT_SHA -> GIT_COMMIT
#   -> RENDER_GIT_COMMIT -> VERCEL_GIT_COMMIT_SHA -> GITHUB_SHA
# Railway injects RAILWAY_GIT_COMMIT_SHA automatically, so leaving both of
# these unset still produces correctly release-tagged events. Set APP_VERSION
# when you want a human-readable version (e.g. 1.4.2) instead of a SHA.
# Deploy the frontend from the same commit and both report the same release.
# SENTRY_RELEASE=
# APP_VERSION=

# ==============================================================================
# OPERATIONAL ALERT DELIVERY
# ==============================================================================
# Critical alerts (health rules, payment/refund dead-letters and quarantines,
# repeated scheduled-job failures) are delivered here IN ADDITION to the in-app
# admin notification. Both destinations are optional and independent — with
# neither set, alerts remain in-app only and nobody is paged.
#
# Set at least one in production.

# Comma-separated addresses. Delivered through the existing MailerSend + BullMQ
# email pipeline, so MAIL_PROVIDER/MAILERSEND_API_KEY must also be configured.
ALERT_EMAIL_RECIPIENTS=

# A single provider-agnostic JSON webhook. The payload carries structured
# fields plus `text` and `content`, so a Slack- or Discord-style incoming
# webhook renders it with no vendor integration.
# TREAT AS A SECRET — the token is in the URL path, and it is fingerprint-
# checked so staging cannot page the production channel.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_MS=5000

# Minimum gap between EXTERNAL deliveries of the same incident key. In-app
# notifications are never suppressed. Default 900 (15 minutes).
ALERT_MIN_INTERVAL_SECONDS=900

# Cross-replica cache stampede protection
CACHE_LOCK_TTL_MS=10000
CACHE_LOCK_WAIT_TIMEOUT_MS=3000
CACHE_LOCK_POLL_INTERVAL_MS=20
