# ==============================================================================
# LEARNIX API / WORKER / MIGRATE — AWS (ECS Fargate) runtime environment
# ==============================================================================
# Reference only. On AWS nothing is read from a file: Terraform
# (learnix-infra/environments/<env>/apps.tf) writes these into the task
# definitions, and values marked SECRET come from Secrets Manager at task start.
# Use this file to reproduce an AWS task locally (with local endpoints) or to
# review what a deployment runs with. Every <...> is a placeholder.
# Details per variable: docs/AWS_RUNTIME_ENV.md
# ==============================================================================

# --- Process -------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production                 # staging on staging
PORT=3000
PROCESS_ROLE=api                   # api | worker | all (single-service staging)
RUN_MIGRATIONS=false               # migrations run in the one-shot migrate task
TRUST_PROXY_HOPS=2                 # CloudFront + ALB
LOG_FORMAT=json
REQUIRE_TLS_BACKENDS=true
GIT_SHA=<commit sha>               # set by the deploy pipeline

# --- PostgreSQL (RDS) — DATABASE_URL is composed by scripts/docker-entrypoint.sh
DB_HOST=<rds endpoint>
DB_PORT=5432
DB_NAME=learnix                    # learnix_staging on staging (isolation guard)
DB_USER=<SECRET: <prefix>/db-app, key username (the DML-only application role)>
DB_PASSWORD=<SECRET: <prefix>/db-app, key password>
# Migrate task only (master credentials in DB_USER/DB_PASSWORD there): creates and grants the application role.
# APP_DB_USER=<SECRET: <prefix>/db-app, key username>
# APP_DB_PASSWORD=<SECRET: <prefix>/db-app, key password>
DATABASE_SSL_CA_FILE=/app/certs/rds-ca-bundle.pem

# --- Valkey (ElastiCache) — REDIS_URL is composed by the entrypoint (rediss://)
REDIS_HOST=<primary endpoint>
REDIS_PORT=6379
REDIS_AUTH_TOKEN=<SECRET: cache auth secret>
REDIS_NAMESPACE=production         # staging on staging

# --- Application secrets (Secrets Manager "core") ------------------------------
JWT_SECRET=<SECRET>
JWT_REFRESH_SECRET=<SECRET>
COOKIE_SECRET=<SECRET>
MEETING_TOKEN_ENCRYPTION_KEY=<SECRET: escrow outside AWS>
PAYOUT_ACCOUNT_ENCRYPTION_KEY=<SECRET: escrow outside AWS>
ADMIN_INIT_EMAIL=<admin email>
ADMIN_INIT_PASSWORD=<SECRET>
METRICS_BEARER_TOKEN=<SECRET>

# --- URLs (two origins: the frontend stays on Vercel, AWS serves the API host) ---
# FRONTEND_URL  the Vercel-hosted app (password-reset links, payment return, health probe)
# BACKEND_URL   the API host behind CloudFront + WAF (webhook/OAuth callbacks, protected download links, media URLs)
# CORS_ORIGINS  exact https origins allowed to call the API with credentials; must include FRONTEND_URL;
#               no wildcards, no *.vercel.app previews in production
FRONTEND_URL=https://learnix.school
BACKEND_URL=https://api.learnix.school
CORS_ORIGINS=https://learnix.school

# --- Object storage (S3; credentials = ECS task role) --------------------------
S3_BUCKET=<files bucket>
S3_REGION=eu-central-1
AWS_REGION=eu-central-1

# --- Video (S3 -> MediaConvert -> CloudFront signed cookies) -------------------
VIDEO_SOURCE_BUCKET=<video source bucket>
VIDEO_OUTPUT_BUCKET=<video output bucket>
MEDIACONVERT_ROLE_ARN=<arn:aws:iam::<account>:role/...-mediaconvert>
MEDIA_EVENTS_QUEUE_URL=<https://sqs.eu-central-1.amazonaws.com/<account>/...-media-events>
VIDEO_PUBLIC_ORIGIN=https://api.learnix.school
CLOUDFRONT_KEY_PAIR_ID=<public key id in the key group>
CLOUDFRONT_PRIVATE_KEY_B64=<SECRET: cloudfront-signing secret>

# --- Email (SES) ---------------------------------------------------------------
MAIL_PROVIDER=ses
SES_REGION=eu-central-1
SES_CONFIGURATION_SET=<configuration set>
MAIL_FROM_EMAIL=no-reply@learnix.school
MAIL_EVENTS_QUEUE_URL=<mail feedback queue url>
# MAIL_ALLOWLIST=<comma-separated>   # staging only; refused on production

# --- SMS (AWS End User Messaging SMS) ------------------------------------------
SMS_PROVIDER=aws
SMS_AWS_CONFIGURATION_SET=<configuration set>
SMS_AWS_ORIGINATION_IDENTITY=<registered Egypt sender ID>
SMS_EVENTS_QUEUE_URL=<sms delivery events queue url>
# SMS_MODE=sandbox                   # staging only

# --- Web Push (standard VAPID; no Firebase) ------------------------------------
PUSH_PROVIDER=webpush
VAPID_SUBJECT=mailto:ops@learnix.school
VAPID_PUBLIC_KEY=<SECRET: vapid secret>
VAPID_PRIVATE_KEY=<SECRET: vapid secret>

# --- Payments (external: EasyKash; no AWS equivalent) --------------------------
# Required in production mode, the app refuses to boot without them (Terraform sets both):
PAYMENT_CAPTURE_GRACE_SECONDS=300
PAYMENT_PROVIDER_CLOCK_SKEW_SECONDS=120
# Optional: EASYKASH_API_BASE_URL, EASYKASH_PAYMENT_OPTIONS, EASYKASH_CASH_EXPIRY_HOURS
# (extra_environment in tfvars). Staging must NOT set any EASYKASH_* value.
EASYKASH_API_KEY=<SECRET: easykash secret>
EASYKASH_HMAC_SECRET=<SECRET: easykash secret>
# Both secrets are mapped through extra_secrets in tfvars from <project>/<env>/easykash.

# --- Observability --------------------------------------------------------------
QUEUE_METRICS_NAMESPACE=Learnix/Queues
QUEUE_METRICS_ENVIRONMENT=learnix-production
# Set by Terraform when application_signals_enabled (ADOT + CloudWatch agent sidecar):
# OTEL_AWS_APPLICATION_SIGNALS_ENABLED=true
# OTEL_RESOURCE_ATTRIBUTES=service.name=api,deployment.environment=production,aws.log.group.names=...
# NODE_OPTIONS=--require /otel-auto-instrumentation-node/autoinstrumentation.js
# OTEL_TRACES_SAMPLER=xray, OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4316/v1/traces, ...

# --- Not set on AWS (legacy providers; rollback only until Phase 8) -----------
# R2_*, TWILIO_*, FIREBASE_*, SENTRY_*, RAILWAY_* (MailerSend and Brevo are removed; MAILERSEND_*/BREVO_* also fail the audit)
# learnix-infra/scripts/provider-audit.mjs fails if any of them appears in the AWS configuration.
