{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Identity", "Effect": "Allow", "Action": "sts:GetCallerIdentity", "Resource": "*" },
    {
      "Sid": "ReadOnlyDiscovery",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters", "ecs:DescribeServices", "ecs:ListTasks", "ecs:DescribeTasks",
        "application-autoscaling:DescribeScalableTargets",
        "rds:DescribeDBInstances", "rds:DescribeDBInstanceAutomatedBackups", "rds:ListTagsForResource",
        "elasticache:DescribeReplicationGroups",
        "elasticloadbalancing:DescribeTargetHealth",
        "ec2:DescribeVpcs",
        "cloudwatch:DescribeAlarms",
        "synthetics:GetCanary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcsScale",
      "Effect": "Allow",
      "Action": "ecs:UpdateService",
      "Resource": "arn:aws:ecs:eu-central-1:486940690416:service/learnix-*/*"
    },
    {
      "Sid": "AutoScalingTargets",
      "Effect": "Allow",
      "Action": "application-autoscaling:RegisterScalableTarget",
      "Resource": "arn:aws:application-autoscaling:eu-central-1:486940690416:scalable-target/*"
    },
    {
      "Sid": "RdsStartStop",
      "Effect": "Allow",
      "Action": ["rds:StopDBInstance", "rds:StartDBInstance"],
      "Resource": "arn:aws:rds:eu-central-1:486940690416:db:learnix-*"
    },
    {
      "Sid": "RdsPrePauseSnapshot",
      "Effect": "Allow",
      "Action": ["rds:CreateDBSnapshot", "rds:AddTagsToResource"],
      "Resource": [
        "arn:aws:rds:eu-central-1:486940690416:db:learnix-*",
        "arn:aws:rds:eu-central-1:486940690416:snapshot:pre-pause-*"
      ]
    },
    {
      "Sid": "Alarms",
      "Effect": "Allow",
      "Action": ["cloudwatch:DisableAlarmActions", "cloudwatch:EnableAlarmActions"],
      "Resource": "arn:aws:cloudwatch:eu-central-1:486940690416:alarm:learnix-*"
    },
    {
      "Sid": "Canary",
      "Effect": "Allow",
      "Action": ["synthetics:StartCanary", "synthetics:StopCanary"],
      "Resource": "arn:aws:synthetics:eu-central-1:486940690416:canary:learnix-*"
    },
    {
      "Sid": "DrBackupStatusRead",
      "Effect": "Allow",
      "Action": "rds:DescribeDBInstanceAutomatedBackups",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": ["eu-central-1", "eu-west-1"] } }
    },
    {
      "Sid": "StateFiles",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::learnix-*-logs-486940690416/ops/pause/*"
    },
    {
      "Sid": "StateListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::learnix-*-logs-486940690416",
      "Condition": { "StringLike": { "s3:prefix": "ops/pause/*" } }
    }
  ]
}
