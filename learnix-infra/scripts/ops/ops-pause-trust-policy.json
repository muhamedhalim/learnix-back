{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NamedOperatorWithMfa",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::486940690416:user/<OPERATOR_IAM_USER>" },
      "Action": "sts:AssumeRole",
      "Condition": { "Bool": { "aws:MultiFactorAuthPresent": "true" } }
    }
  ]
}
