# Environment for the local load-test api/worker containers. Everything here is a throwaway value for a
# disposable local stack: none of it is a credential for any real service, and no real provider key may be
# added (the run script refuses to start if one appears; see learnix-infra/loadtest/README.md).
#
# NODE_ENV=development on purpose: with NODE_ENV=production the auth cookies are Secure and k6 will not send
# them back over http://localhost. Fidelity deltas are listed in docs/performance/load-test-results.md.
NODE_ENV=development
APP_ENV=development
PORT=3000
TYPEORM_SYNCHRONIZE=false
TYPEORM_LOGGING=false
RUN_MIGRATIONS=false

DB_HOST=postgres
DB_PORT=5432
DB_NAME=lms_load
DB_USER=postgres
DB_PASSWORD=lms_load_password
REDIS_URL=redis://redis:6379

JWT_SECRET=loadtest-jwt-secret-0000000000000000000000000000000000
JWT_REFRESH_SECRET=loadtest-refresh-secret-0000000000000000000000000000
COOKIE_SECRET=loadtest-cookie-secret-00000000000000000000000000000
INIT_SECRET=loadtest-init-secret-000000000000000000000000000000
METRICS_BEARER_TOKEN=loadtest-metrics-token
PERFORMANCE_SLOW_QUERY_MS=100

MARKETPLACE_ENABLED=false

# The load Postgres presents a self-signed certificate (see docker-compose.loadtest.yml).
SSL_REJECT_UNAUTHORIZED=false
