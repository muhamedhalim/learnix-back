# Copy to .env.development.local for host-run development services.
# This file is used only by `npm run start:dev` and `npm run dev:infra:up`.
NODE_ENV=development
APP_ENV=development
TYPEORM_SYNCHRONIZE=false
PORT=3001

# Local-only signing and bootstrap credentials. Generate unique values; never
# copy production credentials into this file.
JWT_SECRET=replace-with-a-local-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-local-random-secret-at-least-32-characters
COOKIE_SECRET=replace-with-a-third-local-random-secret-at-least-32-characters
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ADMIN_INIT_EMAIL=mohamedhalemm40@gmail.com
ADMIN_INIT_PASSWORD=cgi4.RknN`E4vyC?!9b4P35
BCRYPT_ROUNDS=12

LEARNIX_DEV_POSTGRES_DB=learnix_dev
LEARNIX_DEV_POSTGRES_USER=learnix_dev
LEARNIX_DEV_POSTGRES_PASSWORD=learnix_dev_password
DATABASE_URL=postgresql://learnix_dev:learnix_dev_password@localhost:54330/learnix_dev

REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=learnix:dev
